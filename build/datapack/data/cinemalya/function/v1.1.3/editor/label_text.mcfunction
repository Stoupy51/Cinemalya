
#> cinemalya:v1.1.3/editor/label_text
#
# @executed	as @e[type=text_display,tag=cinemalya.keyframe]
#
# @within	cinemalya:v1.1.3/editor/unmark_teleport with storage cinemalya:editor label [ as @e[type=text_display,tag=cinemalya.keyframe] ]
#			cinemalya:v1.1.3/editor/label with storage cinemalya:editor label
#
# @args		n (unknown)
#

$data modify entity @s text set value {text:"$(n)",color:"gold",bold:true}

